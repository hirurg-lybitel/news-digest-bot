# Secrets for local runs (copy to .env)
OPENAI_API_KEY=
OPENAI_SECURITY_KEY=
# Optional
# OPENAI_PROJECT_KEY=proj_...
# OPENAI_PROXY_URL=https://chatgpt-proxy.gdmn.app/openai
TELEGRAM_BOT_TOKEN=

# Channels (same bot, different locales)
TELEGRAM_CHANNEL_ID_RU=@dayessence_ru
TELEGRAM_CHANNEL_ID_EN=@dayessence_en

# Mini App public URL (GitHub Pages — register in BotFather /newapp)
MINI_APP_URL=https://hirurg-lybitel.github.io/news-digest-bot
TELEGRAM_BOT_USERNAME=dayessence_bot
MINI_APP_SHORT_NAME=digest

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# DIGEST_TOP_N=10
# MINI_APP_TOP_N=30
# DEFAULT_LOOKBACK_HOURS=12
# MAX_LOOKBACK_HOURS=24
